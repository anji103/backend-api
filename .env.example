# =============================================================================
# OHMIND API — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=OhMind API
APP_VERSION=0.1.0
DEBUG=true
ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL via asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ohmind:ohmind_secret@localhost:5432/ohmind_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# JWT (RS256)
# Generate keys with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the contents below (keep newlines as \n).
# ---------------------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER_REPLACE_ME\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPLACEHOLDER_REPLACE_ME\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Apple OAuth
# ---------------------------------------------------------------------------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
